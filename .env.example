# Environment variables for CKAN Native Cloud Storage Extension

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Container and Service Bus Queue names
AZURE_FILE_SYSTEM_NAME=ckan-storage
AZURE_SERVICEBUS_QUEUE_NAME=ckan-file-events
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://your_namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key

# Development mode (set to true to use emulators)
USE_AZURE_EMULATOR=true

# CKAN Configuration
CKAN_SITE_URL=http://localhost:5000
CKAN_SQLALCHEMY_URL=postgresql://ckan_default:pass@localhost/ckan_default